<?xml version="1.0"?>
<robot name="mobile_platform_2wheel_4caster">

  <material name="body"><color rgba="0.2 0.6 0.3 1.0"/></material>
  <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>

  <link name="base_link">
    <visual>
      <geometry><box size="0.60 0.45 0.12"/></geometry>
      <origin xyz="0 0 0.14" rpy="0 0 0"/>
      <material name="body"/>
    </visual>
    <collision>
      <geometry><box size="0.60 0.45 0.12"/></geometry>
      <origin xyz="0 0 0.14" rpy="0 0 0"/>
    </collision>
    <inertial>
      <origin xyz="0 0 0.14" rpy="0 0 0"/>
      <mass value="18.0"/>
      <inertia ixx="0.7" ixy="0.0" ixz="0.0" iyy="0.9" iyz="0.0" izz="1.2"/>
    </inertial>
  </link>

  <link name="left_wheel">
    <visual>
      <geometry><cylinder radius="0.10" length="0.05"/></geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.10" length="0.05"/></geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.2"/>
      <inertia ixx="0.006" ixy="0.0" ixz="0.0" iyy="0.003" iyz="0.0" izz="0.003"/>
    </inertial>
  </link>

  <link name="right_wheel">
    <visual>
      <geometry><cylinder radius="0.10" length="0.05"/></geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.10" length="0.05"/></geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.2"/>
      <inertia ixx="0.006" ixy="0.0" ixz="0.0" iyy="0.003" iyz="0.0" izz="0.003"/>
    </inertial>
  </link>

  <link name="caster_fl">
    <visual>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0002" ixy="0.0" ixz="0.0" iyy="0.0002" iyz="0.0" izz="0.0002"/>
    </inertial>
  </link>
  
  <link name="caster_fr">
    <visual>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0002" ixy="0.0" ixz="0.0" iyy="0.0002" iyz="0.0" izz="0.0002"/>
    </inertial>
  </link>
  
  <link name="caster_rl">
    <visual>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0002" ixy="0.0" ixz="0.0" iyy="0.0002" iyz="0.0" izz="0.0002"/>
    </inertial>
  </link>
  
  <link name="caster_rr">
    <visual>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0002" ixy="0.0" ixz="0.0" iyy="0.0002" iyz="0.0" izz="0.0002"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0.0 0.24 0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0.0 -0.24 0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="caster_fl_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_fl"/>
    <origin xyz="0.24 0.16 0.04" rpy="0 0 0"/>
  </joint>

  <joint name="caster_fr_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_fr"/>
    <origin xyz="0.24 -0.16 0.04" rpy="0 0 0"/>
  </joint>

  <joint name="caster_rl_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_rl"/>
    <origin xyz="-0.24 0.16 0.04" rpy="0 0 0"/>
  </joint>

  <joint name="caster_rr_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_rr"/>
    <origin xyz="-0.24 -0.16 0.04" rpy="0 0 0"/>
  </joint>

</robot>
