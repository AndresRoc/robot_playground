<?xml version="1.0"?>
<robot name="scara_4dof">

  <material name="orange"><color rgba="0.9 0.5 0.1 1.0"/></material>
  <material name="dark"><color rgba="0.2 0.2 0.2 1.0"/></material>

  <link name="base_link">
    <visual>
      <geometry><cylinder radius="0.14" length="0.12"/></geometry>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <material name="dark"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.14" length="0.12"/></geometry>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
    </collision>
    <inertial>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <mass value="7.0"/>
      <inertia ixx="0.05" ixy="0.0" ixz="0.0" iyy="0.05" iyz="0.0" izz="0.03"/>
    </inertial>
  </link>

  <link name="link_1">
    <visual>
      <geometry><box size="0.35 0.08 0.08"/></geometry>
      <origin xyz="0.175 0 0" rpy="0 0 0"/>
      <material name="orange"/>
    </visual>
    <collision>
      <geometry><box size="0.35 0.08 0.08"/></geometry>
      <origin xyz="0.175 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <origin xyz="0.175 0 0" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.004" ixy="0.0" ixz="0.0" iyy="0.03" iyz="0.0" izz="0.03"/>
    </inertial>
  </link>

  <link name="link_2">
    <visual>
      <geometry><box size="0.25 0.07 0.07"/></geometry>
      <origin xyz="0.125 0 0" rpy="0 0 0"/>
      <material name="dark"/>
    </visual>
    <collision>
      <geometry><box size="0.25 0.07 0.07"/></geometry>
      <origin xyz="0.125 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <origin xyz="0.125 0 0" rpy="0 0 0"/>
      <mass value="1.2"/>
      <inertia ixx="0.002" ixy="0.0" ixz="0.0" iyy="0.015" iyz="0.0" izz="0.015"/>
    </inertial>
  </link>

  <link name="z_slide">
    <visual>
      <geometry><cylinder radius="0.03" length="0.20"/></geometry>
      <origin xyz="0 0 -0.10" rpy="0 0 0"/>
      <material name="orange"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.03" length="0.20"/></geometry>
      <origin xyz="0 0 -0.10" rpy="0 0 0"/>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.10" rpy="0 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.0002"/>
    </inertial>
  </link>

  <link name="tool0">
    <visual>
      <geometry><sphere radius="0.025"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.025"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.00008" ixy="0.0" ixz="0.0" iyy="0.00008" iyz="0.0" izz="0.00008"/>
    </inertial>
  </link>

  <!-- 4 DOF SCARA: R-R-P-R -->
  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="60" velocity="2.0"/>
  </joint>

  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0.35 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="40" velocity="2.5"/>
  </joint>

  <joint name="joint_3" type="prismatic">
    <parent link="link_2"/>
    <child link="z_slide"/>
    <origin xyz="0.25 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.20" upper="0.0" effort="20" velocity="0.3"/>
  </joint>

  <joint name="joint_4" type="revolute">
    <parent link="z_slide"/>
    <child link="tool0"/>
    <origin xyz="0 0 -0.20" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="3.0"/>
  </joint>

</robot>
